{
  "family": "frontend-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["EC2"],
  "executionRoleArn": "<EXECUTION_ROLE_ARN>",
  "containerDefinitions": [
    {
      "name": "frontend",
      "image": "<IMAGE1_NAME>",
      "essential": true,
      "cpu": 256,
      "memory": 512,
      "portMappings": [
        { "containerPort": 3000, "protocol": "tcp" }
      ],
      "environment": [
        { "name": "PORT", "value": "3000" },
        { "name": "MYSQL_SSL", "value": "false" }
      ],
      "secrets": [
        { "name": "MYSQL_HOST",     "valueFrom": "<MYSQL_HOST_SSM_ARN>" },
        { "name": "MYSQL_USER",     "valueFrom": "<MYSQL_USER_SSM_ARN>" },
        { "name": "MYSQL_PASSWORD", "valueFrom": "<MYSQL_PASSWORD_SSM_ARN>" },
        { "name": "MYSQL_DATABASE", "valueFrom": "<MYSQL_DATABASE_SSM_ARN>" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/frontend-task",
          "awslogs-region": "<AWS_REGION>",
          "awslogs-stream-prefix": "frontend"
        }
      }
    }
  ]
}
